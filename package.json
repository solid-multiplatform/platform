{
  "name": "@solid-multiplatform/platform",
  "version": "0.1.0",
  "description": "Portable Solid primitives and device hosts",
  "type": "module",
  "exports": {
    ".": {
      "roku": "./dist/src/portable.js",
      "@solidtv/source": "./src/index.ts",
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    },
    "./primitives": {
      "@solidtv/source": "./src/primitives/index.ts",
      "import": {
        "types": "./dist/src/primitives/index.d.ts",
        "default": "./dist/src/primitives/index.js"
      }
    },
    "./primitives/router": {
      "@solidtv/source": "./src/primitives/routerIndex.ts",
      "import": {
        "types": "./dist/src/primitives/routerIndex.d.ts",
        "default": "./dist/src/primitives/routerIndex.js"
      }
    },
    "./devtools": {
      "@solidtv/source": "./src/devtools/index.ts",
      "import": {
        "types": "./dist/src/devtools/index.d.ts",
        "default": "./dist/src/devtools/index.js"
      }
    },
    "./devtools/jsx-locator": "./src/devtools/jsx-locator.js",
    "./shaders": {
      "@solidtv/source": "./src/core/shaders.ts",
      "import": {
        "types": "./dist/src/core/shaders.d.ts",
        "default": "./dist/src/core/shaders.js"
      }
    },
    "./focusManager": {
      "@solidtv/source": "./src/core/focusManager.ts",
      "import": {
        "types": "./dist/src/core/focusManager.d.ts",
        "default": "./dist/src/core/focusManager.js"
      }
    },
    "./jsx-runtime": {
      "@solidtv/source": "./jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.d.ts"
    },
    "./package.json": "./package.json",
    "./roku": "./hosts/roku/main.ts",
    "./roku/preset": "./hosts/roku/preset.mjs",
    "./roku/storage": "./hosts/roku/device-storage.ts",
    "./roku/tasks": "./hosts/roku/worker-task.ts",
    "./apple-tv": "./hosts/apple-tv/index.mjs",
    "./android-tv": "./hosts/android-tv/index.mjs",
    "./nativescript": "./dist/src/hosts/nativescript/index.js",
    "./nativescript/webpack": "./hosts/nativescript/webpack.cjs",
    "./browser-tv": "./dist/src/hosts/browser-tv.js",
    "./browser-tv/canvas": "./dist/src/hosts/canvas.js"
  },
  "sideEffects": false,
  "scripts": {
    "start": "pnpm run watch",
    "bench": "node bench/run.mjs",
    "test": "vitest",
    "lint": "pnpm run lint:prettier && pnpm run lint:oxlint",
    "lint:fix": "pnpm run lint:fix:prettier && pnpm run lint:fix:oxlint",
    "lint:prettier": "prettier --check \"**/*.{ts,js,cjs,md}\"",
    "lint:fix:prettier": "prettier --write \"**/*.{ts,js,cjs,md}\"",
    "lint:oxlint": "oxlint",
    "lint:fix:oxlint": "oxlint --fix",
    "build": "rm -rf dist && npm run tsc && cp jsx-runtime.d.ts dist/",
    "tsc": "tsc && tsc -p tests/tsconfig.contract.json",
    "watch": "tsc -w",
    "prepare": "husky && npm run build",
    "prepack": "npm run build",
    "release": "release-it",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:webgl": "vitest run --config=vitest.webgl.config.ts"
  },
  "keywords": [
    "lightning",
    "javascript",
    "canvas",
    "web",
    "tv"
  ],
  "author": "Chris Lorenzo",
  "license": "Apache-2.0",
  "dependencies": {
    "@solid-primitives/event-listener": "^2.4.5",
    "@solid-primitives/list": "^0.1.2",
    "@solid-primitives/mouse": "^2.1.6",
    "@solid-primitives/scheduled": "^1.5.3"
  },
  "devDependencies": {
    "@lightningtv/vite-hex-transform": "^1.1.0",
    "@solid-devtools/debugger": "^0.28.1",
    "@solidjs/testing-library": "^0.8.10",
    "@vitest/browser-playwright": "^4.1.6",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.4",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "1.56.1",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.13",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.6",
    "@solid-multiplatform/renderer": "file:vendor/solid-multiplatform-renderer-0.1.0.tgz",
    "solid-js": "1.9.17"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{js,cjs,md}": "prettier --write"
  },
  "peerDependencies": {
    "@solidjs/router": "^0.16.1",
    "@solid-multiplatform/renderer": "^0.1.0",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {},
  "repository": "github:solid-multiplatform/platform",
  "files": [
    "dist",
    "src",
    "jsx-runtime.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs/AI_CODING_GUIDELINES.md",
    "hosts",
    "PROVENANCE.md"
  ],
  "packageManager": "pnpm@10.33.4",
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#default-backend": {
      "roku": "./dist/src/hosts/native-backend.js",
      "types": "./src/hosts/web-backend.ts",
      "@solidtv/source": "./src/hosts/web-backend.ts",
      "default": "./dist/src/hosts/web-backend.js"
    }
  }
}
