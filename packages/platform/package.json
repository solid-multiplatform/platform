  "sideEffects": false,
  "scripts": {
    "start": "pnpm run watch",
    "bench": "node bench/run.mjs",
    "test": "vitest run && npm run test:cli",
    "test:cli": "node --test tests/cli/unit/*.test.mjs",
    "typecheck:cli": "tsc -p cli/tsconfig.json",
    "build": "rm -rf dist && npm run tsc && cp jsx-runtime.d.ts dist/",
    "tsc": "tsc && tsc -p tests/tsconfig.contract.json",
    "watch": "tsc -w",
    "prepack": "npm run build && node cli/renderer-archive.mjs",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:webgl": "vitest run --config=vitest.webgl.config.ts",
    "typecheck:native": "tsc -p hosts/nativescript/tsconfig.android.json",
    "typecheck:apple": "tsc -p hosts/nativescript/tsconfig.apple.json",
    "test:webgl:chromium": "vitest run --config=vitest.webgl.config.ts --project=chromium",
    "test:webgl:webkit": "vitest run --config=vitest.webgl.config.ts --project=webkit",
    "test:webgl:firefox": "vitest run --config=vitest.webgl.config.ts --project=firefox"
  },
