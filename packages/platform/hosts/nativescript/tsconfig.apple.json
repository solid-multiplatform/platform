{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@solid-multiplatform/platform",
    // There are no tvOS typings: providers are typed against the iOS SDK and
    // the manifest decides what tvOS gets.
    "types": ["@nativescript/types-ios/complete", "solid-js", "vite/client"],
    "customConditions": ["@solidtv/source"]
  },
  "include": [
    "providers/apple/**/*.ts",
    "../../tests/native-device/apple-probe/**/*.ts"
  ]
}
