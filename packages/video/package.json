{
  "name": "@solid-multiplatform/video",
  "type": "module",
  "version": "0.2.0-preview.3",
  "description": "Optional headless playback integration for Solid Multiplatform",
  "license": "MIT OR Apache-2.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    },
    "./native": {
      "types": "./native.d.mts",
      "default": "./native.mjs"
    },
    "./android": {
      "types": "./android.d.mts",
      "default": "./android.mjs"
    },
    "./apple": {
      "types": "./apple.d.mts",
      "default": "./apple.mjs"
    },
    "./roku": {
      "types": "./roku.d.mts",
      "default": "./roku.mjs"
    },
    "./desktop": {
      "types": "./desktop.d.mts",
      "default": "./desktop.mjs"
    },
    "./swift": "./swift/SolidPlayback.swift"
  },
  "dependencies": {
    "@mediabunny/ac3": "1.57.0",
    "@mediabunny/dts": "1.57.0",
    "@mediabunny/prores": "1.57.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-http": "2.6.1",
    "hls.js": "1.7.3",
    "mediabunny": "1.56.2"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "core",
    "core.mjs",
    "native.mjs",
    "android.mjs",
    "apple.mjs",
    "upstream",
    "roku.mjs",
    "desktop.mjs",
    "*.d.mts",
    "swift",
    "PROVENANCE.md",
    "platforms/android",
    "android-driver.mjs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@roku-sdk/solid": "2.19.0",
    "@nativescript/core": ">=9.1.0"
  },
  "peerDependenciesMeta": {
    "@roku-sdk/solid": {
      "optional": true
    },
    "@nativescript/core": {
      "optional": true
    }
  },
  "nativescript": {
    "platforms": {
      "android": "9.1.0",
      "ios": "9.1.0",
      "tvos": "9.1.0"
    }
  }
}
