{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "@roku-sdk/interfaces/global"
    ],
    "noImplicitAny": false
  },
  "include": [
    "canvas/**/*.ts",
    "webgl/**/*.ts",
    "roku/**/*.ts",
    "contracts.ts"
  ]
}
