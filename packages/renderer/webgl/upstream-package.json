{
  "name": "@solidtv/renderer",
  "version": "2.0.10",
  "description": "SolidTV Renderer",
  "type": "module",
  "main": "./dist/exports/index.js",
  "exports": {
    ".": "./dist/exports/index.js",
    "./utils": "./dist/exports/utils.js",
    "./shaders": "./dist/exports/shaders.js",
    "./webgl/shaders": "./dist/exports/webgl-shaders.js",
    "./inspector": "./dist/exports/inspector.js",
    "./platform": "./dist/exports/platform.js"
  },
  "scripts": {
    "start": "cd examples && pnpm start",
    "start:prod": "cd examples && pnpm start:prod",
    "build": "tsc --build",
    "build:docker": "cd visual-regression && pnpm build:docker",
    "watch": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --exclude 'src/core/allocation.*.test.ts'",
    "test:visual": "cd visual-regression && pnpm test:visual",
    "test:visual:update": "cd visual-regression && pnpm test:visual:update",
    "test:visual:update-ci": "cd visual-regression && pnpm test:visual:update-ci",
    "size": "pnpm build && cd examples && pnpm size",
    "lint": "pnpm run lint:prettier && pnpm run lint:oxlint",
    "lint:fix": "pnpm run lint:fix:prettier && pnpm run lint:fix:oxlint",
    "lint:prettier": "prettier --check \"**/*.{ts,js,cjs,md}\"",
    "lint:fix:prettier": "prettier --write \"**/*.{ts,js,cjs,md}\"",
    "lint:oxlint": "oxlint . --ignore-pattern examples",
    "lint:fix:oxlint": "oxlint --fix . --ignore-pattern examples",
    "prepare": "husky install",
    "prepack": "rm -rf dist && pnpm run build",
    "node-version": "node --version",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solid-tv/renderer.git"
  },
  "sideEffects": false,
  "keywords": [
    "SolidTV",
    "SolidJS",
    "WebGL",
    "JS",
    "WPE"
  ],
  "author": "Chris Lorenzo",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/solid-tv/renderer/issues"
  },
  "homepage": "https://github.com/solid-tv/renderer#readme",
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^2.8.8",
    "release-it": "^20.0.1",
    "typescript": "~7.0.2",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{js,cjs,md}": "prettier --write"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "exports",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "npm": ">= 10.0.0",
    "pnpm": ">= 10.17.0",
    "node": ">= 18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
